# Cache control headers for Netlify

# HTML files - always revalidate to get latest asset references
/index.html
  Cache-Control: no-cache

# Service worker: the kill switch that removes the old Create React App
# worker (public/service-worker.js). Always revalidate, so the old worker's
# update check gets this file rather than a cached copy.
/service-worker.js
  Cache-Control: no-cache

/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/.well-known/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/curate-agent-context.md
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: public, max-age=3600

/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600

/skills/kleros-curate/SKILL.md
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: public, max-age=3600

# The skill's other references redirect to kleros/kleros-skills
# (public/_redirects); this one is served from here, as upstream still names
# the Gnosis list of lists Kleros replaced on 17 Nov 2026.
/skills/kleros-curate/references/verify-your-list.md
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: public, max-age=3600

# Vite's build files (/assets/…) are cached for a year by one rule per file,
# appended to the build's copy of this file by vite.config.ts: a /assets/*
# rule would also cover the 404 a missing file gets (public/_redirects).
