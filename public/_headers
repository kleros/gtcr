# Cache control headers for Netlify

# HTML files - always revalidate to get latest asset references
/index.html
  Cache-Control: no-cache

# Service worker - always revalidate (even though we're unregistering it,
# this ensures any old cached service-worker.js gets refreshed)
/service-worker.js
  Cache-Control: no-cache

/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/.well-known/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/curate-agent-context.md
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: public, max-age=3600

/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600

/skills/kleros-curate/SKILL.md
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: public, max-age=3600

# Vite's build output: every file name carries a content hash and changes
# when the content does, so browsers can keep them for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
