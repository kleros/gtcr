REACT_APP_IPFS_GATEWAY=https://cdn.kleros.link
REACT_APP_DEFAULT_NETWORK=1
REACT_APP_REJECT_ALL_POLICY_URI="/ipfs/QmZ7RVU7re1g8nXDbAFMHV99pyie3dn4cY7Ga2X4h8mDpV/reject-all-policy.pdf"

# Kleros Atlas endpoint for SIWE-authenticated IPFS uploads.
REACT_APP_ATLAS_URI=https://atlas.production.kleros.link

# Reown project ID, from https://dashboard.reown.com: the app does not render without it.
REACT_APP_REOWN_PROJECT_ID=

# Envio indexer for Light and Classic lists.
REACT_APP_SUBGRAPH_MAINNET=https://indexer.hyperindex.xyz/[api-key]/v1/graphql
REACT_APP_SUBGRAPH_GNOSIS=https://indexer.hyperindex.xyz/[api-key]/v1/graphql
REACT_APP_SUBGRAPH_SEPOLIA=https://indexer.hyperindex.xyz/[api-key]/v1/graphql

# Stake Curate subgraphs (Goldsky, public).
REACT_APP_SUBGRAPH_MAINNET_PERMANENT=https://api.goldsky.com/api/public/project_cmgx9all3003atlp2bqha1zif/subgraphs/pgtcr-mainnet/0.0.3/gn
REACT_APP_SUBGRAPH_GNOSIS_PERMANENT=https://api.goldsky.com/api/public/project_cmgx9all3003atlp2bqha1zif/subgraphs/pgtcr-gnosis/0.0.3/gn
REACT_APP_SUBGRAPH_SEPOLIA_PERMANENT=https://api.goldsky.com/api/public/project_cmgx9all3003atlp2bqha1zif/subgraphs/pgtcr-sepolia/0.0.3/gn

# All fields below this line are optional -------------

# Alchemy API key. Without it every chain uses public RPC endpoints, and
# Ethereum's refuses the long log scans some pages make (src/config/rpc.ts).
REACT_APP_ALCHEMY_API_KEY=

# For the Seer registries in Mainnet and Gnosis.
REACT_APP_SEER_SUBGRAPH_MAINNET=https://gateway.thegraph.com/api/[api-key]/subgraphs/id/BMQD869m8LnGJJfqMRjcQ16RTyUw6EUx5jkh3qWhSn3M
REACT_APP_SEER_SUBGRAPH_GNOSIS=https://gateway.thegraph.com/api/[api-key]/subgraphs/id/B4vyRqJaSHD8dRDb3BFRoAzuBK18c1QQcXq94JbxDxWH
