# The settings of the build the browser tests run against (e2e/build.mjs).
#
# Every service is a placeholder on the reserved .test domain: the tests
# answer each request from e2e/recordings (support/network.ts), and
# `yarn test:e2e:record` sends it to the real service your .env names for
# the same variable. Nothing here is a secret, and nothing in .env is ever
# written to a recording: requests are keyed by these variable names.
#
# Every variable the app reads is listed, so a developer's .env cannot leak
# into this build (process.env outranks .env files in Vite's loadEnv).

REACT_APP_IPFS_GATEWAY=https://cdn.kleros.link
REACT_APP_HOSTED_GRAPH_IPFS_ENDPOINT=
REACT_APP_FRAME_SITE_URL=
REACT_APP_METAMASK_SITE_URL=
REACT_APP_TRUST_SITE_URL=
REACT_APP_DEFAULT_NETWORK=1
REACT_APP_REJECT_ALL_POLICY_URI=/ipfs/QmZ7RVU7re1g8nXDbAFMHV99pyie3dn4cY7Ga2X4h8mDpV/reject-all-policy.pdf
REACT_APP_COURT_FUNCTIONS_URL=https://court-functions.e2e.test
REACT_APP_ATLAS_URI=https://atlas.e2e.test
REACT_APP_WALLETCONNECT_BRIDGE_URL=
REACT_APP_NOTIFICATIONS_API_URL=
# The app does not render without a wallet-kit project id (README); this
# one only has to look like one. The wallet kit's own calls are refused.
REACT_APP_REOWN_PROJECT_ID=e2e00000000000000000000000000000
REACT_APP_INSTRUCTION_VIDEO=

# No Alchemy key: each chain then reads from its one public RPC, unbatched
# (config/rpc.ts), and the recorder sends those reads to Alchemy.
REACT_APP_ALCHEMY_API_KEY=

REACT_APP_SUBGRAPH_MAINNET=https://standard.e2e.test/1
REACT_APP_SUBGRAPH_GNOSIS=https://standard.e2e.test/100
REACT_APP_SUBGRAPH_SEPOLIA=https://standard.e2e.test/11155111
REACT_APP_SUBGRAPH_MAINNET_PERMANENT=https://stake.e2e.test/1
REACT_APP_SUBGRAPH_GNOSIS_PERMANENT=https://stake.e2e.test/100
REACT_APP_SUBGRAPH_SEPOLIA_PERMANENT=https://stake.e2e.test/11155111
REACT_APP_SEER_SUBGRAPH_MAINNET=https://seer.e2e.test/1
REACT_APP_SEER_SUBGRAPH_GNOSIS=https://seer.e2e.test/100
REACT_APP_SUBGRAPH_KLEROS_DISPLAY_MAINNET_ENDPOINT=https://display.e2e.test/1
REACT_APP_SUBGRAPH_KLEROS_DISPLAY_GNOSIS_ENDPOINT=https://display.e2e.test/100
REACT_APP_SUBGRAPH_KLEROS_DISPLAY_SEPOLIA_ENDPOINT=https://display.e2e.test/11155111
