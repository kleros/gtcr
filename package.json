{
  "name": "gtcr",
  "description": "A UI for the Kleros powered Generalized Token Curated List",
  "version": "3.0.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "yarn@4.7.0",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "test:e2e:record": "E2E_RECORD=1 playwright test -c e2e/playwright.config.ts --workers=1",
    "test:e2e:serve": "node e2e/build.mjs && vite preview --outDir build-e2e --port 4173 --strictPort",
    "test:e2e:report": "playwright show-report e2e/report",
    "lint": "eslint \"./src/**/*.ts\" \"./src/**/*.tsx\" \"./e2e/**/*.ts\"",
    "lint:eslint:fix": "eslint \"./src/**/*.ts\" \"./src/**/*.tsx\" \"./e2e/**/*.ts\" --fix",
    "lint:prettier:fix": "prettier --write \"./src/**/*.ts\" \"./src/**/*.tsx\" \"./e2e/**/*.{ts,mjs}\"",
    "format": "yarn run lint:eslint:fix && yarn run lint:prettier:fix"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-regular-svg-icons": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/react-fontawesome": "^0.2.6",
    "@kleros/erc-792": "^4.0.1",
    "@kleros/gtcr-encoder": "^1.6.1",
    "@kleros/kleros-app": "^2.2.2",
    "@kleros/ui-components-library": "^3.8.0",
    "@reown/appkit": "1.7.1",
    "@reown/appkit-adapter-wagmi": "1.7.1",
    "@tanstack/query-core": "^5.90.20",
    "@tanstack/react-query": "^5.90.21",
    "@wagmi/core": "^2.22.1",
    "ethers": "^5.8.0",
    "formik": "^2.4.9",
    "graphql": "^16.12.0",
    "graphql-request": "^7.4.0",
    "humanize-duration": "^3.33.2",
    "localforage": "^1.10.0",
    "mime": "^3.0.0",
    "react": "^18.3.1",
    "react-blockies": "^1.4.1",
    "react-dom": "^18.3.1",
    "react-error-boundary": "^6.1.1",
    "react-is": "^16.13.1",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.30.6",
    "react-toastify": "^11.0.5",
    "styled-components": "^5.3.11",
    "use-debounce": "^10.1.0",
    "viem": "^2.46.2",
    "wagmi": "^2.19.5",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.2",
    "@commitlint/config-conventional": "^20.4.2",
    "@playwright/test": "1.56.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.1",
    "@types/humanize-duration": "^3.27.4",
    "@types/mime": "^3.0.0",
    "@types/node": "16.7.10",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@types/styled-components": "^5.1.36",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-promise": "^4.2.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-unicorn": "^9.1.1",
    "jsdom": "26.1.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vite-plugin-node-polyfills": "^0.22.0",
    "vite-plugin-svgr": "^4.2.0",
    "vite-tsconfig-paths": "^4.3.0",
    "vitest": "4.1.12"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "volta": {
    "node": "20.19.0",
    "yarn": "1.22.22"
  },
  "resolutions": {
    "@reown/appkit-adapter-wagmi/@wagmi/connectors": "^5.7.11",
    "@types/react": "^18.3.28",
    "@ethersproject/abi": "5.8.0",
    "@ethersproject/abstract-provider": "5.8.0",
    "@ethersproject/abstract-signer": "5.8.0",
    "@ethersproject/address": "5.8.0",
    "@ethersproject/basex": "5.8.0",
    "@ethersproject/bignumber": "5.8.0",
    "@ethersproject/bytes": "5.8.0",
    "@ethersproject/constants": "5.8.0",
    "@ethersproject/contracts": "5.8.0",
    "@ethersproject/hash": "5.8.0",
    "@ethersproject/hdnode": "5.8.0",
    "@ethersproject/json-wallets": "5.8.0",
    "@ethersproject/keccak256": "5.8.0",
    "@ethersproject/logger": "5.8.0",
    "@ethersproject/networks": "5.8.0",
    "@ethersproject/pbkdf2": "5.8.0",
    "@ethersproject/properties": "5.8.0",
    "@ethersproject/providers": "5.8.0",
    "@ethersproject/random": "5.8.0",
    "@ethersproject/rlp": "5.8.0",
    "@ethersproject/sha2": "5.8.0",
    "@ethersproject/signing-key": "5.8.0",
    "@ethersproject/solidity": "5.8.0",
    "@ethersproject/strings": "5.8.0",
    "@ethersproject/transactions": "5.8.0",
    "@ethersproject/units": "5.8.0",
    "@ethersproject/wallet": "5.8.0",
    "@ethersproject/web": "5.8.0",
    "@ethersproject/wordlists": "5.8.0",
    "vitest/vite": "npm:^6.4.5"
  }
}
